---
import type { AestheticPhoto } from '../data/aesthetic';
import { withBase } from '../utils/paths';

interface Props {
  photos: AestheticPhoto[];
  eagerCount?: number;
}

const { photos, eagerCount = 0 } = Astro.props;
---
<div class="gallery-grid">
  {photos.map((photo, index) => (
    <a class="photo-card" href={withBase(`/aesthetic/${photo.slug}/`)} aria-label={`查看 ${photo.location}${photo.subject ? `的${photo.subject}` : ''} 摄影作品`}>
      <img
        src={withBase(`/images/aesthetic/${photo.filename}`)}
        alt={`${photo.location}${photo.subject ? `，${photo.subject}` : ''} 摄影作品`}
        loading={index < eagerCount ? 'eager' : 'lazy'}
      />
      <span class="photo-caption">
        <span class="photo-tags">
          <span class="photo-location">{photo.location}</span>
          {photo.subject && (photo.subjectLabel ? (
            <span class="photo-context"><b>{photo.subjectLabel}</b>{photo.subject}</span>
          ) : (
            <span class="photo-subject" aria-label={`鸟种：${photo.subject}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 14.2c2.3-2.9 5.5-4.2 8.6-3.7-1.2-2.1-1.1-4.6.2-6.5.8 2.4 2.8 4.1 5.1 4.5 1.9.3 3.5-.2 4.8-1.2-.3 1.9-1.4 3.4-3.1 4.3 1.7.9 2.6 2.4 2.7 4.2-2.1-1.2-4.2-1.4-6.2-.6-1.5.7-2.8 2.1-3.5 4.2-.9-1.6-2.2-2.7-4-3.3-1.6-.5-3.2-.2-4.6.9.1-1 .1-1.9 0-2.8Z" /></svg><em>{photo.subject}</em></span>
          ))}
        </span>
        <span class="photo-info">{photo.dateLabel}</span>
        {photo.equipment && <span class="photo-camera">{photo.equipment}</span>}
      </span>
    </a>
  ))}
</div>
