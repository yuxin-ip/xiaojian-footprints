---
import AestheticGallery from '../../components/AestheticGallery.astro';
import Layout from '../../layouts/Layout.astro';
import { aestheticCollections, aestheticPhotos, getAestheticPhotosForCollection } from '../../data/aesthetic';
import { withBase } from '../../utils/paths';

const allPhotos = [...aestheticPhotos].sort((a, b) => b.sortDate.localeCompare(a.sortDate));
---
<Layout title="美的历程 | 小謇的足迹" description="小謇的摄影作品。">
  <header class="page-title aesthetic-page-title">
    <p class="kicker">Photography</p>
    <h1>美的历程</h1>
    <p>向大家展示小謇的摄影作品。</p>
  </header>
  <section class="collection-strip" aria-label="摄影合集">
    <div class="collection-strip-heading"><span class="kicker">主题合集</span><span>{aestheticPhotos.length} 幅照片</span></div>
    <div class="collection-strip-links">
      {aestheticCollections.map((collection) => (
        <a class="collection-strip-link" href={withBase(`/aesthetic/${collection.slug}/`)}><strong>{collection.name}</strong><span>{getAestheticPhotosForCollection(collection.slug).length} 幅</span></a>
      ))}
      <a class="collection-strip-link collection-strip-all" href="#all-photos"><strong>浏览全部</strong><span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="gallery-wrap" id="all-photos" aria-label="全部摄影作品"><AestheticGallery photos={allPhotos} eagerCount={2} /></section>
</Layout>
