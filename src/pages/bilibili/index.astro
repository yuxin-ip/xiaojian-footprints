---
import BilibiliVideoGrid from '../../components/BilibiliVideoGrid.astro';
import BilibiliVideoModal from '../../components/BilibiliVideoModal.astro';
import Layout from '../../layouts/Layout.astro';
import { bilibiliCollections, bilibiliSpaceUrl, bilibiliVideos } from '../../data/bilibili';
import { withBase } from '../../utils/paths';
---
<Layout title="bilibili视频 | 小謇的足迹" description="小謇在 bilibili 发布的视频与合集。">
  <header class="page-title bilibili-page-title">
    <p class="kicker">Bilibili</p>
    <h1>bilibili视频</h1>
    <p>bilibili免费云盘使用者</p>
    <a class="button-link" href={bilibiliSpaceUrl} target="_blank" rel="noreferrer">进入 B 站主页</a>
  </header>
  <section class="collection-strip" aria-label="视频合集">
    <div class="collection-strip-heading"><span class="kicker">视频合集</span><span>{bilibiliVideos.length} 个视频</span></div>
    <div class="collection-strip-links">
      {bilibiliCollections.map((collection) => (
        <a class="collection-strip-link" href={withBase(`/bilibili/${collection.slug}/`)}><strong>{collection.name}</strong><span>{collection.bvids.length} 个</span></a>
      ))}
      <a class="collection-strip-link collection-strip-all" href="#all-videos"><strong>浏览全部</strong><span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="gallery-wrap video-page-wrap" id="all-videos" aria-label="全部视频"><BilibiliVideoGrid videos={bilibiliVideos} /></section>
  <BilibiliVideoModal />
</Layout>
